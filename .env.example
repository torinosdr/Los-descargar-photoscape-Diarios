# Copiá este archivo a .env y completá los valores. .env no se versiona.

# Conexión a PostgreSQL con el usuario nexo_api (migración 025).
# Supabase: usá el pooler en modo transacción (puerto 6543). El usuario lleva el ref del proyecto:
#   postgres://nexo_api.jhblkksuhhqcondjrevn:CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# (el host exacto está en Supabase → Connect → Transaction pooler).
# Local: postgres://nexo:nexo@localhost:5432/nexo
DATABASE_URL=

# disable (local) | require (cifrado sin verificar certificado) | verify (cifrado + certificado; con DB_SSL_CA)
DB_SSL=disable
# Ruta al certificado raíz de Supabase (Settings → Database → SSL) cuando DB_SSL=verify
DB_SSL_CA=

# Secreto para firmar los access tokens (mínimo 32 caracteres). Generalo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

PORT=3000
# Duración del access token en segundos (el refresh token dura 30 días y rota en cada uso)
ACCESS_TTL_SECONDS=900
# true en producción (HTTPS). Por defecto: true si NODE_ENV=production
COOKIE_SECURE=
# Cantidad de proxies delante del servidor (para tomar la IP real en el límite de intentos), p. ej. 1
TRUST_PROXY=
# Intentos de login por IP cada 15 minutos
LOGIN_RATE_LIMIT=10
